<?xml version="1.0" encoding="UTF-8"?>
<VariablesViewState
   version = "1.0">
   <ContextStates>
      <ContextState
         contextName = "BoardViewModel.movePiece(group:):BoardVM.swift">
         <PersistentStrings>
            <PersistentString
               value = "board.pieces[to]">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "BoardViewModel.handlePieceClick(group:):BoardVM.swift">
      </ContextState>
   </ContextStates>
</VariablesViewState>
